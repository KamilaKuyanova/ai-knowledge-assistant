# Скопируйте в .env и подставьте свой ключ: cp .env.example .env

# --- LLM: любой OpenAI-совместимый провайдер ---------------------------------
# Вариант 1 (по умолчанию): Google Gemini, бесплатный тариф. Ключ: https://aistudio.google.com/apikey
# openai — настоящая модель; stub — заглушка без сети и ключа (для разработки и демо без расхода лимитов)
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Вариант 2: Groq (бесплатный тариф, очень быстрый). Ключ: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Вариант 3: полностью локально через Ollama (без ключа и интернета)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# --- Эмбеддинги: локальная модель, ключ не нужен -------------------------------
EMBEDDINGS_PROVIDER=local

# --- Безопасность -------------------------------------------------------------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Поиск --------------------------------------------------------------------
TOP_K=5
MIN_SCORE=0.35
